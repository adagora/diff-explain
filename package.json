{
  "name": "columbo-review",
  "version": "0.1.0",
  "description": "columbo: a local workflow for understanding code, making changes, and reviewing with evidence across AI agents.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "bin": {
    "columbo": "./dist/cli/main.js",
    "meat": "./dist/cli/main.js"
  },
  "files": [
    "dist",
    "scripts",
    "prime/README.md",
    "prime/activities",
    "prime/review-policy.md",
    "prime/optional",
    "prime/provenance.json",
    ".claude/skills/columbo",
    ".claude/skills/meat",
    ".claude/skills/show-me",
    "docs",
    "NOTICE"
  ],
  "scripts": {
    "setup": "npm run build && npm link && node scripts/install-meat-skill.ts all && node dist/cli/main.js -doctor",
    "doctor": "node src/cli/main.ts -doctor",
    "start": "node src/cli/main.ts",
    "demo": "node src/cli/main.ts -look HEAD",
    "prime": "node src/cli/main.ts prime",
    "review": "node src/cli/main.ts -agent codex",
    "review:claude": "node src/cli/main.ts -agent claude",
    "packet": "node src/cli/main.ts -prompt",
    "observe:baseline": "node scripts/observe-baseline.ts",
    "skill:install": "node scripts/install-meat-skill.ts",
    "skill:sync": "node scripts/install-meat-skill.ts sync",
    "prepack": "npm run build",
    "build": "tsc",
    "postbuild": "node -e \"require('node:fs').chmodSync('dist/cli/main.js', 0o755)\"",
    "test": "node --test",
    "check": "tsc --noEmit && node --test"
  },
  "dependencies": {},
  "devDependencies": {
    "typescript": "^5.5",
    "@types/node": "^20"
  }
}
